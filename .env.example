APP_NAME="Enterprise AI Financial Customer Intelligence Platform"
APP_VERSION="0.1.0"
APP_ENVIRONMENT="local"
APP_API_V1_PREFIX="/api/v1"
APP_CORS_ORIGINS='["http://localhost:3000"]'

DATABASE_URL="sqlite:///../data/enterprise_ai_financial_platform.db"
DATABASE_ECHO=false

DATA_RAW_DIR="../data/raw"
DATA_PROCESSED_DIR="../data/processed"
DATA_EXTERNAL_DIR="../data/external"
DATA_SAMPLES_DIR="../data/samples"

AI_PROVIDER="groq"
AI_MODEL="llama-3.3-70b-versatile"
AI_TEMPERATURE=0.2
AI_TOP_P=0.9
AI_TOP_K=5
AI_MAX_TOKENS=1200
AI_CHUNK_SIZE=1000
AI_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
AI_CONVERSATION_MEMORY=true

LOGGING_LEVEL="INFO"
LOGGING_STRUCTURED=true

NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api/v1"
